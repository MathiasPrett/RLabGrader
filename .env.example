# Copia este archivo como ".env" (en la misma carpeta) y completa tus datos.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# --- Canvas ---
# Dirección de tu Canvas (sin "/" al final)
CANVAS_URL=https://cursos.canvas.uc.cl
# Tu token personal de Canvas (ver README: "Cómo obtener el token de Canvas")
CANVAS_TOKEN=pega_aqui_tu_token_de_canvas
# Número del curso: aparece en la URL del curso, ej. .../courses/123456
COURSE_ID=123456

# --- IA (Groq) ---
AI_PROVIDER=groq
# Tu API key de Groq (ver README: "Cómo obtener la API key de Groq")
GROQ_API_KEY=pega_aqui_tu_api_key_de_groq
GROQ_MODEL=openai/gpt-oss-120b

# --- Planilla de grupos de ayudantes ---
# No hace falta configurarla: copia el Excel en la carpeta planilla/ y se detecta solo.
# Solo si lo quieres en otro lugar, descomenta y pon la ruta:
# ROSTER_XLSX=otra/carpeta/CoordAyudantes.xlsx

# --- Seguridad ---
# 1 = modo prueba: NO envía notas a Canvas. 0 = envío real.
DRY_RUN=1

# Puerto de la app (http://localhost:8765)
# PORT=8765
